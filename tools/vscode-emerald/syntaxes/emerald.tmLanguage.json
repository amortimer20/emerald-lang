{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Emerald",
  "scopeName": "source.emerald",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#members" },
    { "include": "#calls" },
    { "include": "#types" },
    { "include": "#operators" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.emerald",
          "begin": "#\\[",
          "end": "\\]#"
        },
        {
          "name": "comment.line.documentation.emerald",
          "begin": "##",
          "end": "$",
          "patterns": [
            {
              "name": "keyword.other.documentation.emerald",
              "match": "@(example|deprecated|see)\\b"
            }
          ]
        },
        {
          "name": "comment.line.number-sign.emerald",
          "begin": "#(?!\\{)",
          "end": "$"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.emerald",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.emerald" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.emerald" } },
      "patterns": [
        { "name": "constant.character.escape.emerald", "match": "\\\\." },
        {
          "name": "meta.embedded.line.emerald",
          "begin": "#\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.emerald" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.emerald" }
          },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },

    "attributes": {
      "name": "entity.name.function.decorator.emerald",
      "match": "@[A-Za-z_][A-Za-z0-9_]*"
    },

    "declarations": {
      "patterns": [
        {
          "match": "\\b(class|trait|struct)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.emerald" },
            "2": { "name": "entity.name.type.emerald" }
          }
        },
        {
          "match": "\\b(func)\\s+([a-z_][A-Za-z0-9_]*\\??)",
          "captures": {
            "1": { "name": "storage.type.function.emerald" },
            "2": { "name": "entity.name.function.emerald" }
          }
        },
        {
          "match": "\\b(var|const)\\s+([A-Z_][A-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.emerald" },
            "2": { "name": "variable.other.constant.emerald" }
          }
        },
        {
          "match": "\\b(var|const)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.emerald" },
            "2": { "name": "variable.other.declaration.emerald" }
          }
        },
        {
          "match": "\\b(extends|with)\\s+([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.emerald" },
            "2": { "name": "entity.other.inherited-class.emerald" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.emerald",
          "match": "(?<!\\.)\\b(if|then|else|unless|while|until|for|in|return|throw|try|catch)\\b"
        },
        {
          "name": "storage.type.emerald",
          "match": "(?<!\\.)\\b(var|const|func|class|trait|struct|constructor)\\b"
        },
        {
          "name": "storage.modifier.emerald",
          "match": "(?<!\\.)\\b(static|abstract|extends|with|get|set)\\b"
        },
        {
          "name": "keyword.operator.logical.emerald",
          "match": "(?<!\\.)\\b(and|or|not)\\b"
        },
        {
          "name": "variable.language.self.emerald",
          "match": "(?<!\\.)\\bself\\b"
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.emerald",
          "match": "(?<!\\.)\\b(true|false|nothing)\\b"
        },
        {
          "name": "variable.other.constant.emerald",
          "match": "\\b[A-Z][A-Z0-9_]{1,}\\b"
        }
      ]
    },

    "numbers": {
      "patterns": [
        { "name": "constant.numeric.float.emerald", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.emerald", "match": "\\b\\d+\\b" }
      ]
    },

    "members": {
      "patterns": [
        {
          "match": "(\\.)([a-z_][A-Za-z0-9_]*\\?)(?=\\s*[^(\\w]|\\s*$)",
          "captures": {
            "1": { "name": "punctuation.accessor.emerald" },
            "2": { "name": "entity.name.function.predicate.emerald" }
          }
        },
        {
          "match": "(\\.)([a-z_][A-Za-z0-9_]*\\??)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.emerald" },
            "2": { "name": "entity.name.function.member.emerald" }
          }
        },
        {
          "match": "(\\.)([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.emerald" },
            "2": { "name": "variable.other.property.emerald" }
          }
        }
      ]
    },

    "calls": {
      "match": "\\b([a-z_][A-Za-z0-9_]*\\??)(?=\\s*\\()",
      "captures": { "1": { "name": "entity.name.function.call.emerald" } }
    },

    "types": {
      "patterns": [
        {
          "name": "support.class.builtin.emerald",
          "match": "(?<!\\.)\\b(Math|Int|Float|String|Bool|Range|Array|Nothing|Error|Addable|Subtractable|Multipliable|Divisible|Equatable|Ordered)\\b"
        },
        {
          "name": "entity.name.type.emerald",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.emerald", "match": "=>" },
        { "name": "keyword.operator.range.emerald", "match": "\\.\\." },
        {
          "name": "keyword.operator.assignment.emerald",
          "match": "(\\+=|-=|\\*=|/=|=)"
        },
        {
          "name": "keyword.operator.comparison.emerald",
          "match": "(==|!=|<=|>=|<|>)"
        },
        { "name": "keyword.operator.arithmetic.emerald", "match": "\\*\\*|//|[+\\-*/%]" },
        { "name": "keyword.operator.nullable.emerald", "match": "\\?" }
      ]
    },

    "identifiers": {
      "name": "variable.other.emerald",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
    }
  }
}
