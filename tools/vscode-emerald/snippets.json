{
  "Class": {
    "prefix": "class",
    "body": ["class ${1:Name} {", "\t$0", "}"],
    "description": "A class with a braced body"
  },
  "Class (block-free file)": {
    "prefix": "classfile",
    "body": ["class ${1:Name}", "", "$0"],
    "description": "The whole file is the class body — one type per file"
  },
  "Class extending a base": {
    "prefix": "classextends",
    "body": ["class ${1:Name} extends ${2:Base} {", "\t$0", "}"],
    "description": "A subclass"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\tabstract func ${2:required}(): ${3:Int}",
      "",
      "\tfunc ${4:provided}(): ${5:String} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "A trait: what it requires, and what it provides"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name} {", "\tvar ${2:x}: ${3:Float}", "", "\t$0", "}"],
    "description": "An immutable value type"
  },
  "Constructor": {
    "prefix": "constructor",
    "body": ["constructor(${1:name}: ${2:String}) {", "\tself.$1 = $1", "}"],
    "description": "A constructor assigning its parameter to a field"
  },
  "Function": {
    "prefix": "func",
    "body": ["func ${1:name}(${2}): ${3:Int} {", "\t$0", "}"],
    "description": "A function"
  },
  "Property": {
    "prefix": "prop",
    "body": ["var ${1:name}: ${2:Int} {", "\tget { return $0 }", "}"],
    "description": "A computed property"
  },
  "Property with setter": {
    "prefix": "propset",
    "body": [
      "var ${1:name}: ${2:Int} {",
      "\tget { return ${3:self._$1} }",
      "\tset { ${3:self._$1} = value }",
      "}"
    ],
    "description": "A property with get and set"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "\t$0", "}"],
    "description": "A conditional statement"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": ["if ${1:condition} {", "\t$2", "}", "else {", "\t$0", "}"],
    "description": "Stroustrup braces: else on its own line"
  },
  "If expression": {
    "prefix": "ifthen",
    "body": ["if ${1:condition} then ${2:a} else ${3:b}"],
    "description": "The expression form — else is required"
  },
  "Unless": {
    "prefix": "unless",
    "body": ["unless ${1:condition} {", "\t$0", "}"],
    "description": "if not — deliberately takes no else"
  },
  "Until": {
    "prefix": "until",
    "body": ["until ${1:condition} {", "\t$0", "}"],
    "description": "while not"
  },
  "For over a range": {
    "prefix": "for",
    "body": ["for ${1:i} in ${2:1}..${3:5} {", "\t$0", "}"],
    "description": "A range loop"
  },
  "While": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "\t$0", "}"],
    "description": "A while loop"
  },
  "Each": {
    "prefix": "each",
    "body": ["${1:items}.each { ${2:item} => $0 }"],
    "description": "Iterate with a trailing block"
  },
  "Map": {
    "prefix": "map",
    "body": ["${1:items}.map { ${2:item} => $0 }"],
    "description": "Transform each element"
  },
  "Filter": {
    "prefix": "filter",
    "body": ["${1:items}.filter { ${2:item} => $0 }"],
    "description": "Keep the elements that match"
  },
  "Times": {
    "prefix": "times",
    "body": ["${1:5}.times { $0 }"],
    "description": "Repeat a block"
  },
  "Check for nothing": {
    "prefix": "ifnothing",
    "body": ["if ${1:value} != nothing {", "\t$0", "}"],
    "description": "Narrow a maybe to its non-null type"
  },
  "Try / catch": {
    "prefix": "try",
    "body": ["try {", "\t$1", "}", "catch ${2:error} {", "\t$0", "}"],
    "description": "Handle a failure — the catch is required"
  },
  "Throw": {
    "prefix": "throw",
    "body": ["throw \"${1:something went wrong}\""],
    "description": "Throw an error; a String is wrapped in one"
  },
  "Guard with unless": {
    "prefix": "guard",
    "body": ["return ${1:fallback} unless ${2:condition}"],
    "description": "A guard clause — modifiers guard, they do not loop"
  },
  "Doc comment": {
    "prefix": "doc",
    "body": ["## $0"],
    "description": "A documentation comment"
  },
  "Block comment": {
    "prefix": "comment",
    "body": ["#[", "$0", "]#"],
    "description": "A block comment"
  }
}
