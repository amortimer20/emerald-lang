var scores = [1]
scores.append(item: 2)
print(value: 1)
const double = { n: Int => n * 2 }
print(double(n: 1))
# One report per call: a named value's position means nothing to a built-in,
# so nothing else about the call is checked. `Int.to_string`/`format` are the
# exception (15.5) — they take real named, defaulted arguments.
scores.insert(element: 5, index: 0)
scores.remove(element: 1)
