# A file already in the canonical style is an identity case: formatting it
# must change nothing at all.

## Adds two numbers.
func add(left: Int, right: Int): Int {
    return left + right
}

var total = add(1, 2)
if total > 2 {
    print("big")
}
else {
    print("small")
}

for number in 0..<3 {
    print(number)
}
