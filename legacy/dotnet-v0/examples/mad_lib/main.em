# Mad Libs

print("MAD LIBS")
print("--------")

var name      = read_line("Enter a name: ")
var noun      = read_line("Enter a noun: ")
var verb      = read_line("Enter a verb ending in -ing: ")
var adjective = read_line("Enter an adjective: ")
var number    = read_line("Enter a number: ")

print("")
print("One day, #{name} found a #{adjective} #{noun}.")
print("It had been #{verb} for #{number} years straight.")
print("Nobody knew why. #{name} decided not to ask.")
