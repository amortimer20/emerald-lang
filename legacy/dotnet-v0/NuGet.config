<?xml version="1.0" encoding="utf-8"?>
<!--
  The repository builds from Windows and from WSL against the same working tree. A
  machine-wide Windows NuGet config names a Visual Studio fallback folder that does not
  exist under WSL, and restoring a newly added project failed on it. Clearing the list
  here keeps both sides restoring from the same place.
-->
<configuration>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
