#!/usr/bin/env bash
# The `emerald` command. Rebuilds the compiler when a source file is newer than the
# binary, so you never run a stale build by accident.
#
#   emerald run hello.em
#   emerald hello.em
#
# EMERALD_ROOT overrides where the compiler lives; otherwise it is inferred from this
# script's own location, which works whether it is run from the repo or symlinked onto
# PATH.

set -uo pipefail

if [[ -z "${EMERALD_ROOT:-}" ]]; then
    script="${BASH_SOURCE[0]}"
    while [[ -L "$script" ]]; do script="$(readlink -f "$script")"; done
    EMERALD_ROOT="$(cd "$(dirname "$script")/.." && pwd)"
fi

project="$EMERALD_ROOT/src/Emerald"
dll="$project/bin/Debug/net10.0/Emerald.dll"

if [[ ! -f "$project/Emerald.csproj" ]]; then
    echo "emerald: cannot find the compiler at $project" >&2
    echo "         set EMERALD_ROOT to your emerald-lang checkout" >&2
    exit 1
fi

# Rebuild only when something actually changed.
newest_source="$(find "$project" -name '*.cs' -newer "$dll" -print -quit 2>/dev/null || true)"
if [[ ! -f "$dll" || -n "$newest_source" ]]; then
    echo "emerald: building..." >&2
    if ! dotnet build "$project" -v q --nologo -p:UseAppHost=false >/dev/null 2>&1; then
        echo "emerald: build failed" >&2
        dotnet build "$project" --nologo -p:UseAppHost=false 2>&1 | grep -E "error" | head -10 >&2
        exit 1
    fi
fi

exec dotnet "$dll" "$@"
