{
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "A class with a braced body"
  },
  "Class (block-free file)": {
    "prefix": "classfile",
    "body": [
      "class ${1:Name}",
      "",
      "$0"
    ],
    "description": "The whole file is the class body \u2014 one type per file"
  },
  "Class extending a base": {
    "prefix": "classextends",
    "body": [
      "class ${1:Name} extends ${2:Base} {",
      "\t$0",
      "}"
    ],
    "description": "A subclass"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "\tabstract func ${2:required}(): ${3:Int}",
      "",
      "\tfunc ${4:provided}(): ${5:String} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "A trait: what it requires, and what it provides"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\tvar ${2:x}: ${3:Float}",
      "",
      "\t$0",
      "}"
    ],
    "description": "An immutable value type"
  },
  "Constructor": {
    "prefix": "constructor",
    "body": [
      "constructor(${1:name}: ${2:String}) {",
      "\tself.$1 = $1",
      "}"
    ],
    "description": "A constructor assigning its parameter to a field"
  },
  "Function": {
    "prefix": "func",
    "body": [
      "func ${1:name}(${2}): ${3:Int} {",
      "\t$0",
      "}"
    ],
    "description": "A function"
  },
  "Function with a default": {
    "prefix": "funcdef",
    "body": [
      "func ${1:name}(${2:value}: ${3:Int}, ${4:option}: ${5:String} = ${6:\"...\"}): ${7:Int} {",
      "\t$0",
      "}"
    ],
    "description": "Defaults come last; each is evaluated per call"
  },
  "Property": {
    "prefix": "prop",
    "body": [
      "var ${1:name}: ${2:Int} {",
      "\tget { return $0 }",
      "}"
    ],
    "description": "A computed property"
  },
  "Property with setter": {
    "prefix": "propset",
    "body": [
      "var ${1:name}: ${2:Int} {",
      "\tget { return ${3:self._$1} }",
      "\tset { ${3:self._$1} = value }",
      "}"
    ],
    "description": "A property with get and set"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "A conditional statement"
  },
  "If / else": {
    "prefix": "ifelse",
    "body": [
      "if ${1:condition} {",
      "\t$2",
      "}",
      "else {",
      "\t$0",
      "}"
    ],
    "description": "Stroustrup braces: else on its own line"
  },
  "If expression": {
    "prefix": "ifthen",
    "body": [
      "if ${1:condition} then ${2:a} else ${3:b}"
    ],
    "description": "The expression form \u2014 else is required"
  },
  "Unless": {
    "prefix": "unless",
    "body": [
      "unless ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "if not \u2014 deliberately takes no else"
  },
  "For over a range": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:1}..${3:5} {",
      "\t$0",
      "}"
    ],
    "description": "A range loop"
  },
  "For over a collection": {
    "prefix": "forin",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "Walk an array or a string"
  },
  "Break with a guard": {
    "prefix": "break",
    "body": [
      "break if ${1:condition}"
    ],
    "description": "Leave the loop \u2014 break cannot leave a block"
  },
  "Continue with a guard": {
    "prefix": "continue",
    "body": [
      "continue if ${1:condition}"
    ],
    "description": "Skip to the next turn of the loop"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "\t$0",
      "}"
    ],
    "description": "A while loop"
  },
  "Each": {
    "prefix": "each",
    "body": [
      "${1:items}.each { ${2:item} => $0 }"
    ],
    "description": "Iterate with a trailing block"
  },
  "Map": {
    "prefix": "map",
    "body": [
      "${1:items}.map { ${2:item} => $0 }"
    ],
    "description": "Transform each element"
  },
  "Filter": {
    "prefix": "filter",
    "body": [
      "${1:items}.filter { ${2:item} => $0 }"
    ],
    "description": "Keep the elements that match"
  },
  "Times": {
    "prefix": "times",
    "body": [
      "${1:5}.times { $0 }"
    ],
    "description": "Repeat a block"
  },
  "Check for nothing": {
    "prefix": "ifnothing",
    "body": [
      "if ${1:value} != nothing {",
      "\t$0",
      "}"
    ],
    "description": "Narrow a maybe to its non-null type"
  },
  "Try / catch": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "}",
      "catch ${2:error} {",
      "\t$0",
      "}"
    ],
    "description": "Handle a failure \u2014 the catch is required"
  },
  "Throw": {
    "prefix": "throw",
    "body": [
      "throw \"${1:something went wrong}\""
    ],
    "description": "Throw an error; a String is wrapped in one"
  },
  "Guard with unless": {
    "prefix": "guard",
    "body": [
      "return ${1:fallback} unless ${2:condition}"
    ],
    "description": "A guard clause \u2014 modifiers guard, they do not loop"
  },
  "Addable": {
    "prefix": "addable",
    "body": [
      "func add(other: ${1:Self}): ${1:Self} {",
      "\treturn $0",
      "}"
    ],
    "description": "a + b \u2014 requires 'with Addable'"
  },
  "Equatable": {
    "prefix": "equatable",
    "body": [
      "func equals?(other: ${1:Self}): Bool {",
      "\treturn self.${2:field} == other.${2:field}",
      "}"
    ],
    "description": "a == b, and a != b as its negation \u2014 requires 'with Equatable'"
  },
  "Ordered": {
    "prefix": "ordered",
    "body": [
      "func compare(other: ${1:Self}): Int {",
      "\treturn self.${2:field} - other.${2:field}",
      "}"
    ],
    "description": "<, >, <=, >= all read this \u2014 negative, zero, or positive"
  },
  "Indexable": {
    "prefix": "indexable",
    "body": [
      "func at(index: Int): ${1:String} {",
      "\treturn self.${2:items}[index]",
      "}",
      "",
      "func set_at(index: Int, value: ${1:String}) {",
      "\tself.${2:items}[index] = value",
      "}"
    ],
    "description": "a[i] and a[i] = v \u2014 omit set_at for a read-only collection"
  },
  "Doc comment": {
    "prefix": "doc",
    "body": [
      "## $0"
    ],
    "description": "A documentation comment"
  },
  "Block comment": {
    "prefix": "comment",
    "body": [
      "#[",
      "$0",
      "]#"
    ],
    "description": "A block comment"
  },
  "Mirrors a foreign API": {
    "prefix": "mirrors",
    "body": [
      "@mirrors",
      "class ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "Casing warnings off for a type whose names came from elsewhere"
  },
  "Export a field": {
    "prefix": "export",
    "body": [
      "@export",
      "var ${1:speed} = ${2:5.0}"
    ],
    "description": "Show this field in a Unity-style editor"
  },
  "Test function": {
    "prefix": "test",
    "body": [
      "@test",
      "func ${1:name}?(): Bool {",
      "\treturn $0",
      "}"
    ],
    "description": "Mark a function for the test runner"
  },
  "Dictionary": {
    "prefix": "dict",
    "body": [
      "var ${1:scores}: Dictionary<${2:String}, ${3:Int}> = [:]"
    ],
    "description": "An empty dictionary \u2014 [:] , since [] is an empty list"
  },
  "Count with a dictionary": {
    "prefix": "count",
    "body": [
      "var ${1:counts}: Dictionary<${2:String}, Int> = [:]",
      "for ${3:item} in ${4:items} {",
      "\t$1[$3] = $1[$3].or(0) + 1",
      "}"
    ],
    "description": "Counting \u2014 a lookup gives back a maybe, so .or(0) starts it"
  },
  "Set": {
    "prefix": "set",
    "body": [
      "var ${1:seen}: Set<${2:String}> = [].to_set"
    ],
    "description": "An empty set \u2014 a set is a list converted, since braces are blocks here"
  },
  "Set from values": {
    "prefix": "setof",
    "body": [
      "var ${1:vowels} = [${2:\"a\", \"e\"}].to_set"
    ],
    "description": "A set written as a list and converted"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} { ${2:FIRST}, ${3:SECOND} }"
    ],
    "description": "A closed set of names \u2014 values take constant casing"
  },
  "Enum, multi-line": {
    "prefix": "enumlines",
    "body": [
      "enum ${1:Name} {",
      "\t${2:FIRST},",
      "\t${3:SECOND}",
      "}"
    ],
    "description": "Same thing, one value per line"
  },
  "Assert": {
    "prefix": "assert",
    "body": [
      "assert ${1:actual} == ${2:expected}"
    ],
    "description": "Reports the expression and both sides when it does not hold"
  }
}
