<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Emerald.Runtime</RootNamespace>
  </PropertyGroup>

  <!--
    Deliberately references nothing. This is the library emitted programs will link
    against, so anything it depends on ships to every user of the language. §5.4
    already rules out one thing by name: a reference to Reflection.Emit fails an IL2CPP
    build whether or not it is used.
  -->

</Project>
