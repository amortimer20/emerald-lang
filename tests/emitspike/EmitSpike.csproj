<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EmitSpike</AssemblyName>
  </PropertyGroup>

  <!--
    Not part of the emerald CLI, and not meant to become part of it as written; see
    Emitter.cs for why. A small driver in its own project, the same way
    tests/runtimecaller is a plain caller of Emerald.Runtime rather than part of the
    product. This is a plain caller of Emerald.Compiler's spike emitter.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Emerald/Emerald.csproj" />
    <ProjectReference Include="../../src/Emerald.Compiler/Emerald.Compiler.csproj" />
  </ItemGroup>

</Project>
